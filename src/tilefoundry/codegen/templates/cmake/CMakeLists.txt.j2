cmake_minimum_required(VERSION 3.18)
project({{ name }} LANGUAGES CXX{% for language in languages %} {{ language }}{% endfor %})

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})

add_library({{ name }} SHARED{% for source in sources %} "{{ source }}"{% endfor %})
set_target_properties({{ name }} PROPERTIES PREFIX "lib" OUTPUT_NAME "{{ name }}" SUFFIX ".so")
target_include_directories({{ name }} PRIVATE
{%- for include in includes %}
  "{{ include }}"
{%- endfor %}
)
target_link_libraries({{ name }} PRIVATE "{{ tvm_ffi_library }}")
if(NOT APPLE)
  target_link_options({{ name }} PRIVATE -static-libstdc++)
endif()
{% for text in appended %}
{{ text }}
{% endfor %}
